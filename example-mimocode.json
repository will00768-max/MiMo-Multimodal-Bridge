{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "~/.config/mimocode/plugins/mimo-multimodal-bridge/server.ts"
  ],
  "provider": {
    "mimo": {
      "models": {
        "mimo-v2.5": {
          "modalities": {
            "input": ["text", "image", "audio", "video"],
            "output": ["text"]
          }
        },
        "mimo-v2.5-pro": {
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
